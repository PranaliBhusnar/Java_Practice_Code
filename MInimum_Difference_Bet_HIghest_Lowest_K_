import java.util.Arrays;
class Solution {
    public int minimumDifference(int[] nums, int k) {
        Arrays.sort(nums);
        if(nums.length== 1) return 0;
        int min= Integer.MAX_VALUE;
        int i=0,j=k-1;
        while(j<nums.length){
            min=Math.min(min,nums[j]-nums[i]);
            i++;
            j++;
        }
    return min;
    }
}